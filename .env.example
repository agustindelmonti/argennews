# Opcional: sin ANTHROPIC_API_KEY la app funciona en modo demo (guiones de ejemplo).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Modelo barato para moderar y para generar segmentos de tendencias.
ANTHROPIC_MODEL_CHEAP=claude-haiku-5-5
# Opcional: voz del conductor con TTS (si falta, se usa la voz del navegador solo en la vista previa).
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx
PORT=4173

# Administración (/admin.html). Sin ADMIN_TOKEN el panel queda desactivado. Usá algo largo y aleatorio.
ADMIN_TOKEN=
# 1 = las noticias que llegan por MCP se aprueban solas si pasan la moderación con IA (necesita ANTHROPIC_API_KEY).
# Vacío = todas quedan pendientes hasta que las apruebes vos.
AUTO_APPROVE=
# Dónde se guardan noticias y tweets (archivo JSON). En un hosting con disco efímero usá un disco persistente.
DATA_DIR=./data

# Límites diarios (protegen tu gasto y evitan abuso).
DAILY_LIMIT_PER_IP=5
DAILY_LIMIT_GLOBAL=500
MCP_LIMIT_PER_IP=10
MCP_LIMIT_GLOBAL=300
