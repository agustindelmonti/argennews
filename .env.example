# Opcional: sin ANTHROPIC_API_KEY la app funciona en modo demo (guiones de ejemplo).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opcional: voz del conductor con TTS (si falta, se usa la voz del navegador solo en la vista previa).
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx
PORT=4173
# Tope diario de noticias generadas por IP y global (protege tu gasto).
DAILY_LIMIT_PER_IP=5
DAILY_LIMIT_GLOBAL=500
